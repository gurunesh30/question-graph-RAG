# KAQG environment template. Copy to `.env` and fill in real values.

# ---- Neo4j AuraDB ----
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_auradb_password
NEO4J_DATABASE=neo4j

# ---- OpenRouter (LLM) ----
OPENROUTER_API_KEY=sk-or-v1-...
KAQG_MODEL=openai/gpt-4o-mini
KAQG_REQUEST_TIMEOUT=60

# ---- Rust binaries ----
KAQG_INGEST_BINARY=./rust_kg_engine/target/release/kaqg_ingest
KAQG_PAGERANK_BINARY=./rust_kg_engine/target/release/kaqg_pagerank

# ---- Pipeline tuning ----
KAQG_LOG_LEVEL=INFO
KAQG_RETRY_ATTEMPTS=3
KAQG_RETRY_BACKOFF=0.5
